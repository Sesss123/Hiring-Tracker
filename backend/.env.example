# Copy this file to .env and fill in your real values before running the server.
# .env is already in .gitignore-equivalent (see README) — never commit real secrets.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hireline_app
DB_PASSWORD=changeme
DB_NAME=hireline

# Used to sign login tokens (JWT). Generate a random 32+ char string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

PORT=4000

# Used by the HR-triggered "CV Quality Check" feature (POST
# /api/applicants/:id/quality-check) to score CVs with Gemini against a
# fixed rubric (education, experience, skills, certifications, structure,
# achievements). Get a key at https://aistudio.google.com/apikey — never
# commit a real key, and never send it to the frontend.
GEMINI_API_KEY=
